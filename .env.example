# Copy to .env and replace every value marked CHANGE ME. Never commit .env.

# demo: deterministic heuristics + simulated GitHub, no API keys needed
# live: Anthropic models + real GitHub (configure keys below or in Settings)
ORCHESTRA_MODE=demo

# API tokens, one per role (viewer < operator < approver < admin). At least one is required.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ORCHESTRA_ADMIN_TOKEN=CHANGE-ME-admin-token
# ORCHESTRA_APPROVER_TOKEN=
# ORCHESTRA_OPERATOR_TOKEN=
# ORCHESTRA_VIEWER_TOKEN=

# Token the web console uses server-side. Its role is the role every console user gets,
# so deploy the console behind your SSO and use the least role that fits.
ORCHESTRA_WEB_API_TOKEN=CHANGE-ME-admin-token

# Encrypts secrets saved from the Settings page (Fernet key).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ORCHESTRA_SECRET_KEY=

# Live mode
# ORCHESTRA_ANTHROPIC_API_KEY=
# ORCHESTRA_LLM_MODEL=claude-opus-5-5
# ORCHESTRA_LLM_EFFORT=high
# ORCHESTRA_GITHUB_TOKEN=          # fine-grained PAT: contents, issues, pull requests (read/write) on chosen repos
# ORCHESTRA_GITHUB_OAUTH_CLIENT_ID= # enables "Sign in with GitHub" (device flow)

# Execution limits
# ORCHESTRA_MAX_GRAPH_STEPS=60
# ORCHESTRA_WORKFLOW_TIMEOUT_S=900
# ORCHESTRA_MAX_DEBUG_REVISIONS=1

# Sandbox (requires Docker on the API host; see docs/sandbox.md)
# ORCHESTRA_SANDBOX_ENABLED=false
# ORCHESTRA_SANDBOX_IMAGE=orchestra-sandbox-python:3.12

# MCP servers (see docs/mcp.md)
# ORCHESTRA_MCP_CONFIG_PATH=mcp.json

POSTGRES_PASSWORD=CHANGE-ME-postgres
